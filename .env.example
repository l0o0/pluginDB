# Optional PostgreSQL target. Leave empty to use data/db/plugins.sqlite3.
PLUGINDB_DATABASE_URL=

# Set these when writing directly into Soil staging tables.
PLUGINDB_PLUGINS_TABLE=zotero_plugin_staging_plugins
PLUGINDB_PLUGIN_RELEASES_TABLE=zotero_plugin_staging_releases
PLUGINDB_PLUGIN_LOCALES_TABLE=zotero_plugin_staging_locales
